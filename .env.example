# ─── Jira MCP Server — Environment Variables ──────────────────────────────────

# Server Configuration
PORT=3000
AUTH_MODE=open
# API_KEY=your-secret-api-key

# ─── Netlify Deployment ─────────────────────────────────────────────────────
# Set these in Netlify Dashboard → Site Settings → Environment Variables

# Authentication Mode: "open" or "authorized"
# AUTH_MODE=open

# API Key for authorized mode (required if AUTH_MODE=authorized)
# API_KEY=your-secret-api-key

# ─── User Credentials (via HTTP Headers) ────────────────────────────────────
# Users provide these via HTTP headers when connecting to the MCP endpoint:
#
# X-Jira-Base-Url: https://your-domain.atlassian.net
# X-Jira-Email: your-email@example.com
# X-Jira-Token: your-api-token
# X-Jira-Username: your-username (for Server/Data Center)
