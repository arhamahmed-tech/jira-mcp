# ─── Jira MCP — Environment Variables ────────────────────────────────────────

# Base URL of your Jira instance (no trailing slash)
# Required for Jira Cloud and Server/Data Center
JIRA_BASE_URL=https://your-domain.atlassian.net

# ── Authentication ─────────────────────────────────────────────────────────────
# Option A: Jira Server / Data Center (username + password or personal access token)
JIRA_USERNAME=your-username
JIRA_API_TOKEN=your-api-token

# Option B: Jira Cloud (email + API token from https://id.atlassian.com/manage-profile/security/api-tokens)
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=your-cloud-api-token
